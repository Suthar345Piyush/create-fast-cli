package cli

import (
	"context"

	"github.com/urfave/cli/v3"

	"mycli/internal/cli/commands"
)

func New() *cli.Command {
	return &cli.Command{
		Name:  "mycli",
		Usage: "Project generator",

		Commands: []*cli.Command{
			commands.Init(),
			commands.Version(),
		},

		Action: func(ctx context.Context, cmd *cli.Command) error {
			return cmd.ShowHelp()
		},
	}
}

