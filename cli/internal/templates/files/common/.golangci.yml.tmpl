# .golangci.yml
# Generated by create-fast-cli for {{.ProjectName}}
#
# golangci-lint acts as a meta-linter, running multiple code quality tools
# (go vet, staticcheck, gosec, and more) simultaneously to catch bugs,
# bad styling, and security flaws before they reach production.
#
# Docs: https://golangci-lint.run/usage/configuration/
# Run locally: golangci-lint run ./...

version: "2"

linters:
  default: none

  enable:
    # ── Correctness ────────────────────────────────────────────────────────
    - errcheck        # every error return must be checked or explicitly discarded
    - govet           # go vet checks — catches suspicious constructs
    - staticcheck     # comprehensive SA* static analysis suite
    - gosimple        # flags code that can be simplified
    - unused          # reports unused code (vars, types, functions)

    # ── Formatting ─────────────────────────────────────────────────────────
    - gofmt           # enforces standard Go formatting
    - goimports       # enforces import grouping and ordering

    # ── Style ──────────────────────────────────────────────────────────────
    - misspell        # catches spelling mistakes in comments and strings
    - gocritic        # opinionated but high-signal style/diagnostic checks
    - revive          # drop-in replacement for golint; configurable rules

    # ── Best Practices ─────────────────────────────────────────────────────
    - bodyclose       # checks HTTP response bodies are closed
    - noctx           # detects HTTP requests sent without a context.Context
    - prealloc        # hints at slice pre-allocation opportunities
    - godot           # checks that comments end with a period


  settings:
    govet:
      enable-all: true
      disable:
        - fieldalignment   

    revive:
      rules:
        - name: exported
          severity: warning
         
        - name: var-naming
          severity: warning
         
    gocritic:
      enabled-tags:
        - diagnostic
        - style
      disabled-checks:
        - paramTypeCombine   # combining parameter types isn't always clearer

    misspell:
      locale: US

  exclusions:
    rules:
      - path: "_test\\.go$"
        linters:
          - errcheck
          - gocritic


      # Template files are not Go source — skip all linting.
      - path: "internal/templates/"
        linters:
          - all
